 void Host::addRegisteredItem(std::string service) {
   std::string bus_name, object_path;
   std::tie(bus_name, object_path) = getBusNameAndObjectPath(service);
+  // Filter before creating an Item so each named tray owns only its applets.
+  const auto matches = [&](const Json::Value& patterns) {
+    for (const auto& pattern : patterns) {
+      if (pattern.isString() && service.find(pattern.asString()) != std::string::npos) {
+        return true;
+      }
+    }
+    return false;
+  };
+  if (config_["include-items"].isArray() && !matches(config_["include-items"])) return;
+  if (config_["exclude-items"].isArray() && matches(config_["exclude-items"])) return;
+  spdlog::debug("Tray host {} accepted {}", object_path_, service);
+
   auto it = std::find_if(items_.begin(), items_.end(), [&bus_name, &object_path](const auto& item) {
     return bus_name == item->bus_name && object_path == item->object_path;
   });
