+  // Tint a copy: preserve the applet's changing icon shape and alpha channel.
+  Gdk::RGBA color;
+  if (!icon_color_.empty() && color.set(icon_color_)) {
+    pixbuf = pixbuf->copy();
+    auto pixels = pixbuf->get_pixels();
+    const auto channels = pixbuf->get_n_channels();
